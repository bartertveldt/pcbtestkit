                                          "aspect_ratio": 5.3}, "expect": {"required": "standard", "fits": true}},
  {"name": "1.6 mm board with 0.2 mm vias needs the deep-hole option", "measured": {"aspect_ratio": 8.0},
   "expect": {"required": "aspect-8"}},
  {"name": "aspect ratio 10 is not offered", "measured": {"aspect_ratio": 10.0}, "expect": {"fits": false}},
  {"name": "3.5 mil track", "measured": {"track_outer": 0.0889}, "expect": {"fits": false}},
  {"name": "5 mil ring", "measured": {"ring_via_outer": 0.127}, "expect": {"fits": false}}
 ]
}
