{
 "id": "allpcb-2026",
 "name": "ALLPCB standard PCB capability",
 "short": "ALLPCB",
 "vendor": "ALLPCB",
 "kind": "fab-capability",
 "status": "verified",
 "source": "https://www.allpcb.com/standard_pcb_manufacturing_capability.html",
 "verified": "2026-11-25",
 "notes": [
  "The capability page (1-14 layers). Minimum track and spacing 4 mil (0.1 mm); the page strongly suggests 6 mil (0.15 mm) to save cost.",
  "Annular ring 6 mil; vias 8 mil apart on the same net, 17 mil on different nets; component holes of different nets 24 mil apart.",
  "Aspect ratio up to 6:1 normally; 7:1 to 8:1 adds one day.",
  "A solder mask bridge requirement may raise the price.",
  "The page lists a minimum board size of 80 x 80 mm, probably the panel; it is not checked. Only the longer side of the 506 x 580 mm maximum is checked.",
  "Not stated and therefore not checked: via pad diameter, non-plated hole minimum, hole-to-copper clearance, per-copper-weight track widths."
 ],
 "hole_basis": {"pth_offset": 0.0, "npth_offset": 0.0, "ring": "finished", "hole_clearance": "finished"},
 "dimensions": [
  {
   "id": "aspect",
   "label": "Aspect ratio",
   "choose": "cheapest",
   "levels": [
    {"id": "standard", "aliases": ["std"], "label": "Standard (aspect ratio up to 6:1)", "limits": {"aspect_ratio": 6}},
    {"id": "aspect-8", "aliases": ["deep-holes"], "label": "Aspect ratio 7:1 to 8:1 (one day longer)",
     "note": "Adds one day to fabrication.", "limits": {"aspect_ratio": 8}}
   ]
  }
 ],
 "always": {
  "track": {"value": "4mil", "note": "6 mil suggested to save cost"},
  "gap": {"value": "4mil", "note": "6 mil suggested to save cost"},
  "drill_plated": "0.2mm",
  "drill_max": "6.5mm",
  "ring": "6mil",
  "hole_to_hole_via": {"value": "8mil", "note": "same net"},
  "hole_to_hole_diffnet": {"value": "17mil", "note": "vias of different nets"},
  "hole_to_hole_pth": {"value": "24mil", "note": "component holes of different nets"},
  "copper_to_edge": [
   {"when": {"edge_process": {"in": ["vscore"]}}, "value": "0.4mm"},
   {"value": "0.3mm"}
  ],
  "layers_max": 14,
  "thickness_min": "0.4mm",
  "thickness_max": "3.2mm",
  "board_size_max": "580mm",
  "silk_text_thickness": "0.15mm",
  "silk_text_height": "0.8mm",
  "mask_web": {"value": "0.1mm", "note": "a mask bridge requirement may raise the price"}
 },
 "tests": [
