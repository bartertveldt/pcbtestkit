     }
    },
    "value": "1500mm"
   },
   {
    "value": "500mm"
   }
  ],
  "silk_line": {
   "value": "5mil",
   "note": "screen printing; printer printing allows 3 mil"
  },
  "silk_text_height": {
   "value": "30mil",
   "note": "screen printing; printer printing allows 24 mil"
  },
  "mask_web": [
