     "id": "1oz",
     "aliases": [
      "35um"
     ],
     "label": "1 oz (35 um) outer",
     "limits": {
      "copper_max_um": 35,
      "track_outer": "3mil",
      "gap_outer": "3mil",
      "ring": "3.5mil",
      "track_inner": {
       "value": "2.5mil",
       "note": "0.5 oz inner copper"
      },
      "gap_inner": {
       "value": "3mil",
       "note": "0.5 oz inner copper"
      }
     }
    },
    {
     "id": "2oz",
     "aliases": [
      "70um"
     ],
     "label": "2 oz (70 um) outer",
     "limits": {
      "copper_max_um": 70,
      "track_outer": "5.5mil",
      "gap_outer": "5.5mil",
      "ring": "4.5mil"
     }
    }
   ]
  }
 ],
 "always": {
  "drill_plated": [
   {
    "when": {
