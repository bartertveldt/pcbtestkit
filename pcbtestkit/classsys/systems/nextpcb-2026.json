   },
   {
    "value": "0.2mm"
   }
  ],
  "drill_npth": "0.4mm",
  "drill_max": "6.5mm",
  "slot_plated": "0.5mm",
  "slot_npth": "0.5mm",
  "hole_to_hole_via": {
   "value": "8mil",
   "note": "via to via, same net"
  },
  "hole_to_hole_diffnet": "12mil",
  "hole_to_copper_via": "7mil",
  "hole_to_copper_pth": "9mil",
  "hole_to_copper_npth": "8mil",
  "copper_to_edge": [
