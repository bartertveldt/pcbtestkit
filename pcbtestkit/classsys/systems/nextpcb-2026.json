{
 "id": "nextpcb-2026",
 "name": "NextPCB standard PCB capabilities",
 "short": "NextPCB",
 "vendor": "NextPCB",
 "kind": "fab-capability",
 "status": "verified",
 "source": "https://www.nextpcb.com/pcb-capabilities",
 "verified": "2026-11-25",
 "notes": [
  "The standard capability table (rigid FR-4, 1-32 layers). Trace/spacing: outer 3/3 mil at 1 oz and 5.5/5.5 mil at 2 oz; inner 2.5/3 mil at 0.5 oz (inner 1 and 2 oz are not stated, so inner layers are only checked against the 0.5 oz values).",
  "Smallest mechanical drill 0.15 mm, only for boards up to 1.2 mm thick; the page lists plated holes from 0.2 mm otherwise.",
  "Annular ring 3.5 mil at 1 oz, 4.5 mil at 2 oz; production enlarges the ring by 0.2 mm.",
  "Largest board: 1500 x 600 mm (1-2 layers), 1500 x 500 mm (4 layers), 500 x 400 mm (6+ layers); only the longer side is checked.",
  "Not stated and therefore not checked: aspect ratio, surcharges between standard and advanced service (a separate Advanced PCB page exists)."
 ],
 "hole_basis": {
  "pth_offset": 0.0,
  "npth_offset": 0.0,
  "ring": "finished",
  "hole_clearance": "finished"
 },
 "dimensions": [
  {
   "id": "copper",
   "label": "Outer copper weight",
   "choose": "cheapest",
   "monotonic": false,
   "levels": [
