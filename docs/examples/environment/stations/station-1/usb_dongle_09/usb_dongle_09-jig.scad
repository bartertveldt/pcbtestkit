// PCB TestKit solder jig for a batch: 10 boards (5 x 2), 36.250 x 27.500 mm apart
module one_board() {
  // Solder jig for usb_dongle_09 - generated by PCB TestKit (the same shape as the STL)
  // Parts go upside-down into the pockets; the PCB goes top-side down onto the support.
  // Each pocket follows its part's 3D shape: one group of cuts per part below.
  W = 31.000; L = 22.250; support = 5.500; cell = 0.2500;
  
  module cut(i, j, w, h, z) { translate([i * cell, j * cell, z]) cube([w * cell, h * cell, support - z + 0.01]); }
  module up(i, j, w, h, z) { translate([i * cell, j * cell, support - 0.01]) cube([w * cell, h * cell, z - support + 0.01]); }
  
  difference() {
    union() {
      cube([W, L, support]);
      up(0, 0, 124, 11, 6.70);
      up(0, 11, 12, 1, 6.70);
      up(111, 11, 13, 1, 6.70);
      up(0, 12, 11, 2, 6.70);
      up(112, 12, 12, 2, 6.70);
      up(123, 14, 1, 25, 6.70);
      up(0, 74, 11, 15, 6.70);
      up(11, 76, 1, 13, 6.70);
      up(12, 77, 72, 12, 6.70);
      up(84, 79, 1, 10, 6.70);
      up(85, 81, 1, 8, 6.70);
      up(86, 82, 1, 7, 6.70);
      up(87, 84, 1, 5, 6.70);
      up(88, 85, 1, 4, 6.70);
      up(89, 86, 1, 3, 6.70);
      up(90, 87, 1, 2, 6.70);
      up(91, 88, 2, 1, 6.70);
    }
    // C1 (relief)
    cut(58, 22, 14, 12, 3.70);
    // C2 (relief)
    cut(72, 22, 15, 12, 3.70);
    // U1 (relief)
    cut(21, 21, 37, 39, 2.00);
    // notches
    cut(0, 14, 21, 60, 2.00);
    cut(102, 14, 21, 60, 2.00);
  }
}

for (p = [[0.000, 0.000], [36.250, 0.000], [72.500, 0.000], [108.750, 0.000], [145.000, 0.000], [0.000, 27.500], [36.250, 27.500], [72.500, 27.500], [108.750, 27.500], [145.000, 27.500]]) translate([p[0], p[1], 0]) one_board();
cube([176.000, 49.750, 2.000]);   // floor web joining the boards
