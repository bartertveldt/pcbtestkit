// PCB TestKit solder jig for a batch: 9 boards (3 x 3), 46.500 x 27.750 mm apart
module one_board() {
  // Solder jig for usb_dongle_11 - generated by PCB TestKit (the same shape as the STL)
  // Parts go upside-down into the pockets; the PCB goes top-side down onto the support.
  // Each pocket follows its part's 3D shape: one group of cuts per part below.
  W = 41.250; L = 22.500; support = 5.500; cell = 0.2500;
  
  module cut(i, j, w, h, z) { translate([i * cell, j * cell, z]) cube([w * cell, h * cell, support - z + 0.01]); }
  module up(i, j, w, h, z) { translate([i * cell, j * cell, support - 0.01]) cube([w * cell, h * cell, z - support + 0.01]); }
  
  difference() {
    union() {
      cube([W, L, support]);
      up(0, 0, 133, 1, 6.70);
      up(0, 1, 132, 1, 6.70);
      up(0, 2, 131, 1, 6.70);
      up(0, 3, 130, 1, 6.70);
      up(0, 4, 129, 1, 6.70);
      up(0, 5, 128, 1, 6.70);
      up(0, 6, 127, 1, 6.70);
      up(0, 7, 126, 2, 6.70);
      up(0, 9, 125, 2, 6.70);
      up(0, 11, 12, 1, 6.70);
      up(0, 12, 11, 3, 6.70);
      up(164, 50, 1, 40, 6.70);
      up(0, 75, 11, 15, 6.70);
      up(153, 75, 11, 15, 6.70);
      up(11, 77, 1, 13, 6.70);
      up(152, 77, 1, 13, 6.70);
      up(12, 78, 140, 12, 6.70);
    }
    // C1 (relief)
    cut(58, 22, 14, 12, 3.70);
    // C2 (relief)
    cut(72, 22, 15, 12, 3.70);
    // U1 (relief)
    cut(21, 21, 37, 39, 2.00);
    // U2 (relief)
    cut(88, 23, 29, 29, 3.73);
    // notches
    cut(0, 15, 21, 60, 2.00);
    cut(143, 15, 21, 60, 2.00);
  }
}

for (p = [[0.000, 0.000], [46.500, 0.000], [93.000, 0.000], [0.000, 27.750], [46.500, 27.750], [93.000, 27.750], [0.000, 55.500], [46.500, 55.500], [93.000, 55.500]]) translate([p[0], p[1], 0]) one_board();
cube([134.250, 78.000, 2.000]);   // floor web joining the boards
