  "adc_max_v": 10.0,
  "site": 1,
  "_batch_comment": "Batch fixture with 9 sites (one board each; every board's supply and channels on the fixture's batch connector, or on its own header with fixture.batch_connector per_site). With channel_map 'auto', site k uses the ADC inputs right after site k-1's (4 per site, 36 in all: more than 4 ADS1115 on one bus: use mcp3008 or a serial MCU). 'power' has one entry per site so each board is switched on only while it is tested; override a site in 'sites', e.g. {\"2\": {\"channel_map\": {...}, \"power\": {...}}}.",
  "sites": {}
}
